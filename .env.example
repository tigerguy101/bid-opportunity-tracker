# Get a free SAM.gov API key: https://sam.gov -> sign in -> Account Details -> Request API Key
SAM_GOV_API_KEY=your_sam_gov_key_here

# Get a free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Comma-separated keywords to filter opportunities (used as SAM.gov title search terms)
BID_KEYWORDS=IT services,information technology,managed services,network support

# Optional: comma-separated NAICS codes to filter on (541512 = Computer Systems Design Services)
NAICS_CODES=541512,541519,541611
